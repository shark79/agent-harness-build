ENVIRONMENT=development
DEMO_MODE=true
DEMO_FORCE_MODEL_FAILURE=false

# Leave OPENAI_API_KEY blank to run entirely on the deterministic DemoAgentAdapter
# (no external calls, safe offline demo). Set it to use the real OpenAI-backed agent.
OPENAI_API_KEY=
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=gpt-4o

MAX_RUN_TOKENS=20000
MAX_RUN_COST=0.50

# demo = never sends real email, logs "DEMO EMAIL SENT" instead. real = not implemented in this build.
EMAIL_MODE=demo

# Supabase project (see starter-kit/ENVIRONMENT.md for how to get these for your own project)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
