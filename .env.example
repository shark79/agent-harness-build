# MCP service
PORT=8788
CAMPAIGNFORGE_API_KEY=replace-with-a-long-random-value
PUBLISHING_ENABLED=false

# OpenAI Images API: required for generate_image.
# This key is separate from the model-provider connection configured in TrueForge.
OPENAI_API_KEY=
# Sunburst is the quality-oriented GPT Image 2.5 model. Set Flare here only
# when speed is more important than creative fidelity.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium

# Generated PNGs are served to the local TrueForge browser from this base URL.
# Use durable object storage and an HTTPS URL in production.
CAMPAIGNFORGE_ASSET_BASE_URL=http://127.0.0.1:8788
CAMPAIGNFORGE_ASSET_DIR=.campaignforge-assets

# Optional research provider. The tool returns a clear configuration error without it.
FIRECRAWL_API_KEY=

# Platform credentials. Use non-production test accounts during development.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202501
META_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
