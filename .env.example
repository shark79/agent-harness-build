# Agent Control Tower Environment Variables
# Copy .env.example to .env and adjust values for your environment
# See starter-kit/ENVIRONMENT.md for detailed documentation

# -- Agent Configuration --

# When true: use offline DemoAgentAdapter (keyword-based, no external API calls)
# When false: use OpenAIAgentAdapter if OPENAI_API_KEY is set
DEMO_MODE=true

# Your OpenAI API key (get from https://platform.openai.com/api-keys)
# Required only if DEMO_MODE=false; ignored if DEMO_MODE=true
OPENAI_API_KEY=

# Primary model for agent reasoning (only used if DEMO_MODE=false)
PRIMARY_MODEL=gpt-4o-mini

# Fallback model if primary model exhausts retries (only used if DEMO_MODE=false)
FALLBACK_MODEL=gpt-4o

# Force a simulated model failure for testing retry/fallback mechanics
# Also settable per-run: POST /api/runs {"force_model_failure": true}
DEMO_FORCE_MODEL_FAILURE=false

# -- Budget Configuration --

# Maximum tokens per run; stops gracefully at BUDGET_EXCEEDED if exceeded
MAX_RUN_TOKENS=20000

# Maximum estimated cost (USD) per run; stops gracefully if exceeded
# Note: "Estimated Cost" only, not real provider billing
MAX_RUN_COST=0.50

# -- Database Configuration --

# Connection string for the database
#
# Options:
#   SQLite (offline dev / running the test suite without any DB):
#     DATABASE_URL=sqlite+aiosqlite:///./local.db
#
#   Supabase Postgres via the SESSION POOLER (recommended - use this one):
#     DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#     A brand-new Supabase project's direct db.PROJECT_REF.supabase.co host can take a
#     few minutes for DNS to propagate, and some sandboxed/restrictive networks only
#     permit the shared pooler hostname anyway - the pooler works immediately either way.
#     Get the exact string from your Supabase dashboard -> Project Settings -> Database
#     -> Connection string -> "Session pooler". The password may contain a literal "/" -
#     leave it as-is here (unencoded); this app's own DSN parser (see
#     backend/app/config.py) handles that, don't percent-encode it yourself.
#
#   Supabase Postgres direct connection (works once DNS has propagated):
#     DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
#
#   Local Postgres:
#     DATABASE_URL=postgresql://postgres:password@localhost:5432/agent-control-tower
#
DATABASE_URL=sqlite+aiosqlite:///./local.db

# -- Email Configuration --

# Email delivery mode:
#   "demo" (default): logs "DEMO EMAIL SENT" to stdout, never sends real emails
#   "smtp" (not implemented in hackathon): would send via SMTP
EMAIL_MODE=demo

# -- CORS Configuration --

# Comma-separated list of allowed frontend origins
# Leave empty to allow all (dev), or specify explicit origins for production
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend API URL (used by Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# -- Harness Provider --

# Which harness backend to use:
#   "local" (default): in-process HarnessOrchestrator
#   "trueforge" (not implemented): managed TrueForge backend
HARNESS_PROVIDER=local

# -- Environment & Logging --

# Deployment environment (cosmetic, used for logging/context)
ENVIRONMENT=development
