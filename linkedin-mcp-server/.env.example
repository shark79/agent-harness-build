# Local LinkedIn Social Publisher MCP server configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Host/port the MCP server + OAuth routes bind to. Local-only, single operator.
SOCIAL_MCP_HOST=127.0.0.1
SOCIAL_MCP_PORT=8810
# Base URL this server is reachable at (used to build the MCP connector URL / links in status responses).
SOCIAL_MCP_PUBLIC_URL=http://localhost:8810

# LinkedIn developer app credentials (see README.md "LinkedIn developer-app creation").
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8810/oauth/linkedin/callback

# LinkedIn REST API version header, format YYYYMM (e.g. 202509). Pick the latest version
# documented at https://learn.microsoft.com/en-us/linkedin/marketing/versioning
# at setup time - this is deliberately not defaulted, verify the current value yourself.
LINKEDIN_VERSION=

# 32-byte AES-256-GCM key, base64-encoded. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Path to the local SQLite database file (created automatically on first run).
SOCIAL_DATABASE_PATH=./data/social-publisher.sqlite
